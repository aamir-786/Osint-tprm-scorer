# 4. HaveIBeenPwned (Optional: Requires small paid tier, or use free alternatives)
# Used for Reputation (Data Breach Disclosures)
# Get your API key here: https://haveibeenpwned.com/API/Key
# If left blank, system uses a fallback heuristic or free BreachDirectory check.
HIBP_API_KEY=""

# 5. MediaStack (Optional Free News API: https://mediastack.com)
# Used as a fallback if NewsAPI is exhausted or unavailable.
MEDIASTACK_API_KEY=""
